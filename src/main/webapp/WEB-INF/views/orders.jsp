<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.campusconnect.web.Document,java.util.List" %>
<% List<Document> orders=(List<Document>)request.getAttribute("orders"); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Seller orders · Campus Connect</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/campus.css" rel="stylesheet"></head>
<body><% request.setAttribute("activeModule","marketplace"); %><%@ include file="_app-nav.jsp" %><div class="layout"><main class="content"><a class="back-link" href="${pageContext.request.contextPath}/marketplace">← Back to marketplace</a><div class="page-head"><p class="eyebrow">SELLER CENTRE</p><h1>Orders for your listings</h1><p class="text-secondary">See buyer requests and arrange hand-off directly.</p></div><section class="card-grid"><% if(orders.isEmpty()) { %><div class="empty">No orders yet. Your next listing could help a classmate.</div><% } for(Document order:orders) { %><article class="item-card"><span class="badge text-bg-light"><%= order.getString("status") %></span><h3>Order <%= order.get("_id") %></h3><p>Amount: ₹<%= order.get("amount",0) %><br>Payment: <%= order.getString("paymentMethod") %><br>Reference: <%= order.getString("paymentReference") %></p><div class="card-meta"><span><%= order.getString("createdAt") %></span><strong>Buyer <%= order.get("buyerId") %></strong></div></article><% } %></section></main></div></body></html>
