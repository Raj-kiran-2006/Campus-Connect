<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.campusconnect.web.Document,java.util.List" %>
<%! private String esc(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");} %>
<% List<Document> people=(List<Document>)request.getAttribute("people"); List<Document> messages=(List<Document>)request.getAttribute("messages"); Document selected=(Document)request.getAttribute("selected"); Document me=(Document)session.getAttribute("user"); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Messages · Campus Connect</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/campus.css"></head>
<body><% request.setAttribute("activeModule","messages"); %><%@ include file="_app-nav.jsp" %><div class="layout"><main class="content"><div class="page-head"><p class="eyebrow">PRIVATE CONVERSATIONS</p><h1>Messages</h1><p class="text-secondary">Ask a peer about a teaching offer, project, or shared resource.</p></div>
<div class="messaging-layout"><aside class="panel conversation-list"><h3>People</h3><%for(Document p:people){%><a class="<%=selected!=null&&selected.getObjectId("_id").equals(p.getObjectId("_id"))?"selected":""%>" href="${pageContext.request.contextPath}/messages?with=<%=p.getObjectId("_id")%>"><strong><%=esc(p.getString("name"))%></strong><small><%=esc(p.getString("course"))%></small></a><%}%></aside><section class="panel thread-panel"><%if(selected==null){%><div class="empty">Select someone from the list to start a private conversation.</div><%}else{%><div class="thread-header"><div class="directory-avatar"><%=esc(selected.getString("name").substring(0,1).toUpperCase())%></div><div><h2><%=esc(selected.getString("name"))%></h2><small><%=esc(selected.getString("course"))%> · <%=esc(selected.getString("bio"))%></small></div></div><div class="message-list"><%if(messages!=null)for(Document m:messages){boolean mine=me.getObjectId("_id").equals(m.getObjectId("senderId"));%><div class="message-bubble <%=mine?"mine":""%>"><p><%=esc(m.getString("body"))%></p><small><%=esc(m.getString("createdAt"))%></small></div><%}%></div><form class="message-compose" method="post"><input type="hidden" name="recipientId" value="<%=selected.getObjectId("_id")%>"><textarea name="body" class="form-control" maxlength="2000" required placeholder="Write a thoughtful message…"></textarea><button class="btn btn-primary">Send message</button></form><%}%></section></div></main></div></body></html>
