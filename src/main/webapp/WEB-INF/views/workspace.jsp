<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.campusconnect.web.Document" %>
<%@ page import="java.util.List" %>
<%
  String module = (String) request.getAttribute("module");
  List<Document> items = (List<Document>) request.getAttribute("items");
  String title = "Campus workspace";
  String kicker = "CAMPUS CONNECT";
  if ("notes".equals(module)) { title = "Notes library"; kicker = "LEARN TOGETHER"; }
  else if ("questions".equals(module)) { title = "Questions & answers"; kicker = "ASK THE CAMPUS"; }
  else if ("assignments".equals(module)) { title = "Peer support"; kicker = "PEER LEARNING"; }
  else if ("teaching-offers".equals(module)) { title = "Teach a peer"; kicker = "FREE PEER TEACHING"; }
  else if ("marketplace".equals(module)) { title = "Campus marketplace"; kicker = "BUY · SELL · SHARE"; }
  else if ("projects".equals(module)) { title = "Project spaces"; kicker = "COLLABORATE"; }
  else if ("notifications".equals(module)) { title = "Notifications"; kicker = "STAY IN THE LOOP"; }
  else if ("note-requests".equals(module)) { title = "Note requests"; kicker = "REQUEST · SHARE · LEARN"; }
%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Campus Connect</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/campus.css" rel="stylesheet"></head>
<body class="module-<%= module %>"><% request.setAttribute("activeModule", module); %><%@ include file="_app-nav.jsp" %><div class="layout">
<main class="content"><div class="module-banner"><div><p class="eyebrow"><%= kicker %></p><h1><%= title %></h1><p class="text-secondary"><% if ("notes".equals(module)) { %>Find clear, current study material shared by people in your courses.<% } else if ("note-requests".equals(module)) { %>Ask classmates for a specific study resource, then help fulfil requests from your courses.<% } else if ("questions".equals(module)) { %>Ask better questions, share explanations, and build a searchable campus brain.<% } else if ("assignments".equals(module)) { %>Get tutoring and feedback without outsourcing assessed work.<% } else if ("teaching-offers".equals(module)) { %>Offer your knowledge, time, and encouragement to classmates for free.<% } else if ("marketplace".equals(module)) { %>Buy, sell, and rent useful academic items with people nearby.<% } else if ("projects".equals(module)) { %>Find collaborators, share skills, and move ambitious ideas forward.<% } else { %>Stay on top of the activity that matters to you.<% } %></p></div><div class="module-orb"><%= "notes".equals(module) ? "▤" : "questions".equals(module) ? "?" : "assignments".equals(module) ? "✦" : "marketplace".equals(module) ? "▣" : "projects".equals(module) ? "◇" : "●" %></div></div>
<div class="page-actions"><div class="filter-pills"><a class="<%= request.getParameter("sort") == null ? "active" : "" %>" href="${pageContext.request.contextPath}/<%= module %>">All</a><a class="<%= "recent".equals(request.getParameter("sort")) ? "active" : "" %>" href="${pageContext.request.contextPath}/<%= module %>?sort=recent">Recent</a><a class="<%= "popular".equals(request.getParameter("sort")) ? "active" : "" %>" href="${pageContext.request.contextPath}/<%= module %>?sort=popular">Popular</a></div><% if ("marketplace".equals(module)) { %><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/marketplace/orders">Seller orders</a><% } %><% if ("notifications".equals(module)) { %><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">＋ Create notice</button><% } else { %><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">＋ <%= "marketplace".equals(module) ? "List an item" : "Create" %></button><% } %></div>
<% if ("true".equals(request.getParameter("fulfilled"))) { %><div class="alert alert-success">Note added to the library and linked to the request.</div><% } else if ("fulfill".equals(request.getParameter("error"))) { %><div class="alert alert-warning">Provide a valid note URL to fulfil this request.</div><% } %><% if ("true".equals(request.getParameter("deleted"))) { %><div class="alert alert-success">Your contribution was deleted.</div><% } %><% if ("github".equals(request.getParameter("error"))) { %><div class="alert alert-warning">Use a valid GitHub URL beginning with https://github.com/.</div><% } %><% if ("true".equals(request.getParameter("created"))) { %><div class="alert alert-success">Published successfully.</div><% } %><% if ("price".equals(request.getParameter("error"))) { %><div class="alert alert-danger">Enter a valid price between ₹0 and ₹10,00,000.</div><% } %><% if ("assignment".equals(request.getParameter("error"))) { %><div class="alert alert-warning">Add a deadline for this peer-support request.</div><% } %><% if ("required".equals(request.getParameter("error"))) { %><div class="alert alert-warning">Add a title and description before publishing.</div><% } %>
<form class="toolbar" method="get" action="${pageContext.request.contextPath}/<%= module %>"><input class="form-control" name="q" value="<%= request.getAttribute("query") == null ? "" : request.getAttribute("query") %>" placeholder="Search this space..."><input class="form-control" name="category" value="<%= request.getAttribute("categoryFilter") == null ? "" : request.getAttribute("categoryFilter") %>" placeholder="Filter category"><button class="btn btn-primary">Search</button><a class="btn btn-light" href="${pageContext.request.contextPath}/<%= module %>">Clear</a></form>
<div id="cards" class="card-grid"><% for (Document item : items) { String category=item.getString("category"); String status=item.getString("status"); String cardTitle=item.getString("title"); if(cardTitle==null||cardTitle.isBlank()) cardTitle=item.getString("name"); if(cardTitle==null||cardTitle.isBlank()) cardTitle="Untitled contribution"; String description=item.getString("description"); if(description==null||description.isBlank()) description="Campus activity"; Object rawId=item.get("_id"); String id=rawId==null ? "" : rawId.toString(); %><article class="item-card searchable"><% if ("marketplace".equals(module)) { %><a class="card-link" href="${pageContext.request.contextPath}/marketplace/detail?id=<%= id %>"><% } %><div class="item-card-top"><div class="item-icon"><%= "marketplace".equals(module) ? "▣" : "questions".equals(module) ? "?" : "projects".equals(module) ? "◇" : "✦" %></div><span class="badge text-bg-light"><%= category==null||category.isBlank() ? (status==null||status.isBlank() ? "ACTIVE" : status) : category %></span></div><h3><%= cardTitle %></h3><% if (Boolean.TRUE.equals(item.getBoolean("ownerVerified"))) { %><span class="verified-badge">? Verified</span><% } %><% if (item.getString("ownerAvailability") != null && !item.getString("ownerAvailability").isBlank()) { %><small class="availability-label">Available: <%= item.getString("ownerAvailability") %></small><% } %><% if ("activity".equals(module) && "FEEDBACK".equals(item.getString("action")) && item.getString("projectName") != null && !item.getString("projectName").isBlank()) { %><div class="feedback-project-name">Completed project: <strong><%= item.getString("projectName") %></strong></div><% } %><p><%= description %></p><% if ("activity".equals(module) && item.getString("githubUrl") != null && !item.getString("githubUrl").isBlank()) { %><a class="resource-link feedback-repo" target="_blank" rel="noopener" href="<%= item.getString("githubUrl") %>">View project on GitHub ↗</a><% } %><% if ("activity".equals(module) && "FEEDBACK".equals(item.getString("action"))) { %><small class="feedback-label">Peer feedback<% if (item.get("score") != null) { %> · <%= item.get("score") %>/5 rating<% } %></small><% } %><% if ("assignments".equals(module)) { %><div class="detail-row"><span>Deadline</span><strong><%= item.getString("deadline") == null ? "To be agreed" : item.getString("deadline") %></strong></div><div class="detail-row"><span>Support model</span><strong>Free peer exchange</strong></div><% } else if ("teaching-offers".equals(module)) { %><div class="detail-row"><span>Format</span><strong><%= item.getString("format") == null ? "Flexible" : item.getString("format") %></strong></div><div class="detail-row"><span>Schedule</span><strong><%= item.getString("schedule") == null ? "Arrange a time" : item.getString("schedule") %></strong></div><a class="btn btn-sm btn-outline-primary mt-2" href="${pageContext.request.contextPath}/messages?with=<%= item.get("ownerId") %>">Contact teacher</a><% } else if ("notes".equals(module) && item.getString("resourceUrl") != null && !item.getString("resourceUrl").isBlank()) { %><a class="resource-link" target="_blank" rel="noopener" href="<%= item.getString("resourceUrl") %>">Open <%= item.getString("resourceType") == null ? "resource" : item.getString("resourceType") %> ↗</a><% } %><div class="card-meta"><span><%= item.getString("createdAt") == null ? "Recently" : item.getString("createdAt").substring(0, Math.min(10,item.getString("createdAt").length())) %></span><strong><%= "marketplace".equals(module) ? "₹" + item.get("price", 0) + " · View details" : "" %></strong></div><% if (!"marketplace".equals(module)) { %><a class="detail-link" href="${pageContext.request.contextPath}/<%= module %>/detail?id=<%= id %>">Open details →</a><% } %><% if ("marketplace".equals(module)) { %></a><a class="btn btn-primary btn-sm card-buy" href="${pageContext.request.contextPath}/marketplace/detail?id=<%= id %>">View & order</a><% } %><% if ("note-requests".equals(module) && !"FULFILLED".equals(status)) { %><form method="post" action="${pageContext.request.contextPath}/note-requests" class="mt-3"><input type="hidden" name="action" value="fulfill"><input type="hidden" name="id" value="<%= id %>"><input class="form-control form-control-sm mb-2" type="url" name="resourceUrl" placeholder="https://link-to-your-notes" required><input class="form-control form-control-sm mb-2" name="description" placeholder="Short description (optional)"><button class="btn btn-sm btn-outline-primary">Fulfil with this note</button></form><% } %></article><% } %><% if (items.isEmpty()) { %><div class="empty">Nothing here yet. Create the first useful contribution for your campus.</div><% } %></div><div class="module-footer-card"><div><span class="eyebrow">CAMPUS TIP</span><h3><%= "notes".equals(module) ? "Make your notes easy to discover" : "Good contributions compound" %></h3><p><%= "notes".equals(module) ? "Add a clear subject, semester, and short description so classmates can find the right resource quickly." : "A thoughtful question, useful listing, or clear project brief can help dozens of students." %></p></div><span class="tip-mark">✦</span></div></main></div>
<div class="modal fade" id="createModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content workspace-create-modal"><div class="modal-header"><h2 class="modal-title">Create in <%= title %></h2><button class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" action="${pageContext.request.contextPath}/<%= module %>"><div class="modal-body"><label>Title<input class="form-control" name="title" maxlength="140" required></label><% if ("note-requests".equals(module)) { %><label>Subject<input class="form-control" name="subject" maxlength="120" required placeholder="e.g. Operating Systems"></label><% } else { %><% if ("activity".equals(module)) { %><label>Feedback type<select class="form-select" name="targetType"><option value="PROJECT">Completed project opinion</option><option value="ASSIGNMENT">Assignment feedback</option></select></label><label>Completed project name<input class="form-control" name="projectName" maxlength="140" placeholder="e.g. Campus Connect study hub"></label><label>Project rating<select class="form-select" name="score" required><option value="">Choose a rating</option><option value="5">5 / 5 - Excellent</option><option value="4">4 / 5 - Very good</option><option value="3">3 / 5 - Good</option><option value="2">2 / 5 - Needs improvement</option><option value="1">1 / 5 - Needs major changes</option></select></label><% } else { %><label>Category / subject<input class="form-control" name="category"></label><% } %><label><%= "activity".equals(module) ? "Your opinion about this project" : "Description" %><textarea class="form-control" name="description" rows="5" maxlength="5000" required placeholder="<%= "activity".equals(module) ? "Share what worked well and what could be improved..." : "" %>"></textarea></label><% if ("activity".equals(module)) { %><label>GitHub project link <span class="optional-label">(optional)</span><input class="form-control" type="url" name="githubUrl" pattern="https://github.com/.*" placeholder="https://github.com/org/project"></label><% } %><% if ("notifications".equals(module)) { %><label>Type<select class="form-select" name="eventType"><option value="NOTICE">Campus notice</option><option value="EVENT">Campus event</option></select></label><label>Date and time<input class="form-control" type="datetime-local" name="startsAt"></label><label>Location / room<input class="form-control" name="location" placeholder="Auditorium or online link"></label><% } %><% if ("teaching-offers".equals(module)) { %><label>Topics / skills<input class="form-control" name="skills" required placeholder="e.g. Java basics, calculus"></label><label>Format<input class="form-control" name="format" placeholder="Online, library, or flexible"></label><label>Schedule<input class="form-control" name="schedule" placeholder="e.g. Wednesdays 6–7 PM or book a time"></label><% } %><% if ("assignments".equals(module)) { %><label>Preferred date<input class="form-control" type="date" name="deadline" required></label><div class="form-hint">Peer support is free. Exchange explanations, study time, and campus impact points — not money or completed graded work.</div><% } %><% if ("notes".equals(module)) { %><label>Resource link<input class="form-control" type="url" name="resourceUrl" placeholder="https://drive.google.com/..."></label><label>Format<select class="form-select" name="resourceType"><option>PDF</option><option>PPT</option><option>LINK</option></select></label><% } %><% if ("marketplace".equals(module)) { %><label>Price<input class="form-control" type="number" min="0" name="price"></label><label>Book author<input class="form-control" name="author" placeholder="Author name"></label><label>Edition / ISBN<input class="form-control" name="edition" placeholder="Edition or ISBN"></label><label>Condition<select class="form-select" name="condition"><option>Like new</option><option>Good</option><option>Used</option></select></label><label>Listing photo<input id="listingPhoto" class="form-control" type="file" accept="image/png,image/jpeg,image/webp"><input type="hidden" id="imageUrl" name="imageUrl"></label><label>Listing type<select class="form-select" name="listingType"><option value="BOOK_SELL">Sell a book</option><option value="BOOK_RENT">Rent a book</option><option value="EQUIPMENT_RENT">Rent equipment</option></select></label><% } %><% if ("questions".equals(module)) { %><label>Tags<input class="form-control" name="tags" placeholder="java, dbms, design"></label><% } %><% if ("projects".equals(module)) { %><label>GitHub repository<input class="form-control" type="url" name="githubUrl" pattern="https://github.com/.*" placeholder="https://github.com/org/project"></label><label>Skills needed<input class="form-control" name="skills" placeholder="Java, UI/UX, research"></label><label>Tags<input class="form-control" name="tags" placeholder="web, sustainability"></label><label>Next milestone<input class="form-control" name="milestone" placeholder="Prototype review · 15 Oct"></label><label>Collaboration type<select class="form-select" name="collaborationType"><option value="TEAM_PROJECT">Team project</option><option value="RESEARCH">Research</option><option value="HACKATHON">Hackathon</option></select></label><label class="form-check mt-3"><input class="form-check-input" type="checkbox" name="mentorNeeded"> <span class="form-check-label">Looking for a senior mentor</span></label><% } %><% } %></div><div class="modal-footer"><button class="btn btn-primary">Publish</button></div></form></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>function filterCards(q){q=q.toLowerCase();document.querySelectorAll('.searchable').forEach(c=>c.style.display=c.innerText.toLowerCase().includes(q)?'':'none')}document.querySelectorAll('.sidebar a').forEach(a=>a.addEventListener('click',()=>document.querySelector('.sidebar').classList.remove('open')));const photo=document.querySelector('#listingPhoto'),image=document.querySelector('#imageUrl');if(photo)photo.onchange=()=>{const f=photo.files[0];if(!f||f.size>2097152){alert('Choose an image smaller than 2 MB');photo.value='';return}const r=new FileReader();r.onload=()=>image.value=r.result;r.readAsDataURL(f)}</script></body></html>
